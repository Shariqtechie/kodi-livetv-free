                <setting id="view_log" type="action" label="30042">
                    <level>0</level>
                    <data>RunScript(service.freelivetv,view_log)</data>
                    <control type="button" format="action"/>
                </setting>
                <setting id="export_log" type="action" label="30043" help="30044">
                    <level>0</level>
                    <data>RunScript(service.freelivetv,export_log)</data>
                    <control type="button" format="action"/>
                </setting>
                <setting id="toggle_kodi_debug" type="action" label="30045" help="30046">
                    <level>0</level>
                    <data>RunScript(service.freelivetv,toggle_kodi_debug)</data>
