<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings version="1">
    <section id="service.freelivetv">
        <category id="channels" label="30000">
            <group id="1">
                <setting id="country" type="string" label="30010" help="30011">
                    <level>0</level>
                    <default>in</default>
                    <constraints>
                        <allowempty>false</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>30010</heading>
                    </control>
                </setting>
                <setting id="pick_country" type="action" label="30012">
                    <level>0</level>
                    <data>RunScript(service.freelivetv,choose_country)</data>
                    <control type="button" format="action"/>
                </setting>
                <setting id="dedupe" type="boolean" label="30013" help="30014">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="hide_dead" type="boolean" label="30030" help="30031">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="merge_duplicates" type="boolean" label="30050" help="30051">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="check_days" type="integer" label="30032" help="30033">
                    <level>0</level>
                    <default>3</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>30</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
                <setting id="refresh_hours" type="integer" label="30015" help="30016">
                    <level>0</level>
                    <default>12</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>72</maximum>
                    </constraints>
                    <control type="slider" format="integer">
                        <popup>false</popup>
                    </control>
                </setting>
            </group>
        </category>
        <category id="tools" label="30001">
            <group id="1">
                <setting id="check_streams" type="action" label="30034" help="30035">
                    <level>0</level>
                    <data>RunScript(service.freelivetv,check_streams)</data>
                    <control type="button" format="action"/>
                </setting>
                <setting id="run_setup" type="action" label="30020" help="30021">
                    <level>0</level>
                    <data>RunScript(service.freelivetv,setup)</data>
                    <control type="button" format="action"/>
                </setting>
                <setting id="run_refresh" type="action" label="30022">
                    <level>0</level>
                    <data>RunScript(service.freelivetv,refresh)</data>
                    <control type="button" format="action"/>
                </setting>
            </group>
        </category>
        <category id="troubleshooting" label="30002">
            <group id="1">
                <setting id="debug_enabled" type="boolean" label="30040" help="30041">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
